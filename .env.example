# LLM: mock | dashscope
DAILYFEED_LLM=mock
# 事件总线: memory | redis
DAILYFEED_BUS=memory
# 数据源: mock | rss
DAILYFEED_SOURCE=mock

DAILYFEED_DB=data/dailyfeed.db
DAILYFEED_OUTPUT_DIR=data/digests
DAILYFEED_MAX_ARTICLES=20
DAILYFEED_STM_SIZE=8
DAILYFEED_DEDUPE_THRESHOLD=0.92
DAILYFEED_TIMEOUT=120

REDIS_URL=redis://localhost:6379/0
DAILYFEED_REDIS_STREAM=dailyfeed:events
DAILYFEED_REDIS_GROUP=dailyfeed

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

DAILYFEED_RSS_FEEDS=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
